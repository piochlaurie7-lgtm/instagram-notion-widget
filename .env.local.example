# Notion Integration Token (Internal Integration Secret)
# https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database ID (from the database URL)
# e.g. https://notion.so/workspace/DATABASE_ID?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Profile configuration (shown in the widget header) ---
NEXT_PUBLIC_PROFILE_USERNAME=yourusername
NEXT_PUBLIC_PROFILE_DISPLAY_NAME=Your Display Name
NEXT_PUBLIC_PROFILE_BIO=Your bio goes here ✨
NEXT_PUBLIC_PROFILE_WEBSITE=https://yourwebsite.com
NEXT_PUBLIC_PROFILE_AVATAR_URL=https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&h=150&fit=crop

# --- Highlights (JSON array of {label, emoji}) ---
NEXT_PUBLIC_HIGHLIGHTS=[{"label":"Travel","emoji":"✈️"},{"label":"Food","emoji":"🍜"},{"label":"Style","emoji":"👗"},{"label":"Home","emoji":"🏡"},{"label":"Work","emoji":"💼"}]
